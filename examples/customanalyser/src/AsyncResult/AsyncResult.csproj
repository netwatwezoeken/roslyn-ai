<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>preview</LangVersion>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <RootNamespace>AsyncResult</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
<!--        <ProjectReference Include="../StructureGuard.CodeFixes/StructureGuard.CodeFixes.csproj"-->
<!--                          ReferenceOutputAssembly="false"-->
<!--                          PrivateAssets="all" />-->
    </ItemGroup>

    <ItemGroup>
        
        <None Include="$(OutputPath)$(AssemblyName).dll"
              Pack="true"
              PackagePath="analyzers/dotnet/cs/"
              Visible="false" />

        <None Include="buildTransitive\StructureGuard.targets"
               Pack="true"
               PackagePath="buildTransitive\StructureGuard.targets" />

        <None Include="../StructureGuard.CodeFixes/bin/$(Configuration)/netstandard2.0/StructureGuard.CodeFixes.dll"
              Pack="true"
              PackagePath="analyzers/dotnet/cs/"
              Visible="false" />
    </ItemGroup>

    <ItemGroup>
      <AdditionalFiles Remove="AnalyzerReleases.Unshipped.md" />
    </ItemGroup>
</Project>

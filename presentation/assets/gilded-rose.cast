[0.054, "o", "\u001b[?2026h\u001b[?25l\u001b[3;35r\u001b[35;1H\r\n\r\n\r\n\u001b[r\u001b[10;165H\u001b[38;2;145;152;161m┃\r\r\n\u001b[164C┃\r\r\n\u001b[164C┃\r\u001b[17;165H\u001b[38;2;240;246;252m┃\r\r\n\u001b[164C┃\r\r\n\u001b[164C┃\r\u001b[33;2H\u001b[38;2;61;68;77m│\u001b[162C\u001b[38;2;145;152;161m┃\r\r\n\u001b[C\u001b[38;2;61;68;77m│\u001b[m High complexity means one function is making too many decisions at once. The smell is not the number, it is that the function has quietly taken on more than\u001b[5C\u001b[38;2;145;152;161m┃\r\r\n\u001b[C\u001b[38;2;61;68;77m│\u001b[m  one job. The count is the symptom, tangled responsibilities are the cause.\u001b[86C\u001b[38;2;145;152;161m┃\u001b[m\u001b[?2026l\r\u001b[38;3H\u001b[?25h"]

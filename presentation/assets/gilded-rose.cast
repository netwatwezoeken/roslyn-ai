[0.087, "o", "\u001b[?2026h\u001b[?25l\u001b[3;35r\u001b[35;1H\r\n\r\n\r\n\u001b[r\u001b[16;165H\u001b[38;2;145;152;161m┃\r\r\n\u001b[164C┃\r\r\n\u001b[164C┃\r\r\n\u001b[164C┃\r\u001b[22;165H\u001b[38;2;240;246;252m┃\r\r\n\u001b[164C┃\r\r\n\u001b[164C┃\r\r\n\u001b[164C┃\r\u001b[33;2H\u001b[38;2;61;68;77m│\u001b[m complicated expressions meaningful names. When branching is the main problem, follow the high-complexity guide; shorter code alone does not mean simpler\u001b[9C\u001b[38;2;145;152;161m┃\r\r\n\u001b[C\u001b[38;2;61;68;77m│\u001b[m code.\u001b[156C\u001b[38;2;145;152;161m┃\r\r\n\u001b[C\u001b[38;2;61;68;77m│\u001b[m 4. Check the type, not just its methods. If the reported type combines distinct responsibilities, group related behavior and the data it owns into focused\u001b[7C\u001b[38;2;145;152;161m┃\u001b[m\u001b[?2026l\r\u001b[38;3H\u001b[?25h"]
[0.033, "o", "\u001b[?2026h\u001b[?25l\r\n\r\n \u001b[38;2;68;147;248m●\u001b[m \u001b[?2026l\u001b[2A\b\u001b[?25h"]
[0.035, "o", "\u001b[?2026h\u001b[?25l\u001b[3;35r\u001b[35;1H\r\n\r\n\r\n\u001b[r\u001b[17;165H\u001b[38;2;145;152;161m┃\r\r\n\u001b[164C┃\r\r\n\u001b[164C┃\r\u001b[23;165H\u001b[38;2;240;246;252m┃\r\r\n\u001b[164C┃\r\r\n\u001b[164C┃\r\u001b[33;2H\u001b[38;2;61;68;77m│\u001b[m types. Extracting methods inside the same oversized type may help readability without resolving the underlying design problem. Do not introduce new types\u001b[8C\u001b[38;2;145;152;161m┃\r\r\n\u001b[C\u001b[38;2;61;68;77m│\u001b[m merely to distribute the metric.\u001b[129C\u001b[38;2;145;152;161m┃\r\r\n\u001b[C\u001b[38;2;61;68;77m│\u001b[162C\u001b[38;2;145;152;161m┃\u001b[m\u001b[?2026l\r\u001b[38;3H\u001b[?25h"]
[0.031, "o", "\u001b[?2026h\u001b[?25l\u001b[3;35r\u001b[35;1H\r\n\r\n\r\n\u001b[r\u001b[17;165H\u001b[38;2;145;152;161m┃\r\r\n\u001b[164C┃\r\r\n\u001b[164C┃\r\r\n\u001b[164C┃\r\u001b[23;165H\u001b[38;2;240;246;252m┃\r\r\n\u001b[164C┃\r\r\n\u001b[164C┃\r\r\n\u001b[164C┃\r\u001b[33;2H\u001b[38;2;61;68;77m│\u001b[m Preserve observable behavior throughout. Use existing tests, and add characterization tests where behavior is unclear before restructuring it. Make small\u001b[8C\u001b[38;2;145;152;161m┃\r\r\n\u001b[C\u001b[38;2;61;68;77m│\u001b[m changes and rerun tests and analysis after each meaningful step.\u001b[97C\u001b[38;2;145;152;161m┃\r\r\n\u001b[C\u001b[38;2;61;68;77m│\u001b[162C\u001b[38;2;145;152;161m┃\r\u001b[40;2H\u001b[38;2;68;147;248m◉\u001b[m \u001b[?2026l\u001b[2A\b\u001b[?25h"]
[0.084, "o", "\u001b[?2026h\u001b[?25l\u001b[3;35r\u001b[35;1H\r\n\r\n\r\n\u001b[r\u001b[18;165H\u001b[38;2;145;152;161m┃\r\r\n\u001b[164C┃\r\r\n\u001b[164C┃\r\r\n\u001b[164C┃\r\u001b[24;165H\u001b[38;2;240;246;252m┃\r\r\n\u001b[164C┃\r\r\n\u001b[164C┃\r\r\n\u001b[164C┃\r\u001b[33;2H\u001b[38;2;61;68;77m│\u001b[m Raising the index without improving understanding is not a fix. Do not compress statements, replace clear code with clever expressions, or split code into\u001b[7C\u001b[38;2;145;152;161m┃\r\r\n\u001b[C\u001b[38;2;61;68;77m│\u001b[m arbitrary fragments just to pass the check. Do not lower the configured threshold or suppress the warning merely to make it disappear.\u001b[27C\u001b[38;2;145;152;161m┃\r\r\n\u001b[C\u001b[38;2;61;68;77m│\u001b[162C\u001b[38;2;145;152;161m┃\u001b[m\u001b[?2026l\r\u001b[38;3H\u001b[?25h"]

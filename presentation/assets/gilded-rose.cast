[0.091, "o", "\u001b[?2026h\u001b[?25l\r\n\r\n \u001b[38;2;68;147;248m◉\u001b[m \u001b[?2026l\u001b[2A\b\u001b[?25h"]
[0.089, "o", "\u001b[?2026h\u001b[?25l\u001b[3;35r\u001b[35;1H\r\n\r\n\r\n\u001b[r\u001b[12;165H\u001b[38;2;145;152;161m┃\r\r\n\u001b[164C┃\r\r\n\u001b[164C┃\r\r\n\u001b[164C┃\r\u001b[19;165H\u001b[38;2;240;246;252m┃\r\r\n\u001b[164C┃\r\r\n\u001b[164C┃\r\r\n\u001b[164C┃\r\u001b[33;2H\u001b[38;2;61;68;77m│\u001b[m Reducing the number without reducing the tangle is not a fix. Do not merge conditions with `and`/`or` just to drop a branch, and do not rewrite `if`\u001b[13C\u001b[38;2;145;152;161m┃\r\r\n\u001b[C\u001b[38;2;61;68;77m│\u001b[m statements as ternaries to slip under the check. The condition is still there for a human to hold in their head.\u001b[49C\u001b[38;2;145;152;161m┃\r\r\n\u001b[C\u001b[38;2;61;68;77m│\u001b[162C\u001b[38;2;145;152;161m┃\u001b[m\u001b[?2026l\r\u001b[38;3H\u001b[?25h"]
[0.043, "o", "\u001b[?2026h\u001b[?25l\r\n\r\n \u001b[38;2;68;147;248m◎\u001b[m \u001b[?2026l\u001b[2A\b\u001b[?25h"]
[0.026, "o", "\u001b[?2026h\u001b[?25l\u001b[3;35r\u001b[35;1H\r\n\r\n\r\n\u001b[r\u001b[13;165H\u001b[38;2;145;152;161m┃\r\r\n\u001b[164C┃\r\r\n\u001b[164C┃\r\u001b[20;165H\u001b[38;2;240;246;252m┃\r\r\n\u001b[164C┃\r\r\n\u001b[164C┃\r\u001b[33;2H\u001b[38;2;61;68;77m│\u001b[m The test is not whether the number dropped. It is whether someone reading the function for the first time can hold it in their head at once. If not, it is\u001b[7C\u001b[38;2;145;152;161m┃\r\r\n\u001b[C\u001b[38;2;61;68;77m│\u001b[m still doing too much.\u001b[140C\u001b[38;2;145;152;161m┃\r\r\n\u001b[C\u001b[38;2;61;68;77m│\u001b[162C\u001b[38;2;145;152;161m┃\u001b[m\u001b[?2026l\r\u001b[38;3H\u001b[?25h"]
[0.036, "o", "\u001b[?2026h\u001b[?25l\u001b[3;35r\u001b[35;1H\r\n\r\n\r\n\u001b[r\u001b[13;165H\u001b[38;2;145;152;161m┃\r\r\n\u001b[164C┃\r\r\n\u001b[164C┃\r\r\n\u001b[164C┃\r\u001b[20;165H\u001b[38;2;240;246;252m┃\r\r\n\u001b[164C┃\r\r\n\u001b[164C┃\r\r\n\u001b[164C┃\r\u001b[33;2H\u001b[38;2;61;68;77m│\u001b[m GildedRose.cs:5\u001b[146C\u001b[38;2;145;152;161m┃\r\r\n\u001b[C\u001b[38;2;61;68;77m│\u001b[m GildedRose.cs:14\u001b[145C\u001b[38;2;145;152;161m┃\r\r\n\u001b[C\u001b[38;2;61;68;77m│\u001b[162C\u001b[38;2;145;152;161m┃\r\u001b[40;2H\u001b[38;2;68;147;248m○\u001b[m \u001b[?2026l\u001b[2A\b\u001b[?25h"]
[0.035, "o", "\u001b[?2026h\u001b[?25l\u001b[3;35r\u001b[35;1H\r\n\r\n\r\n\u001b[r\u001b[14;165H\u001b[38;2;145;152;161m┃\r\r\n\u001b[164C┃\r\r\n\u001b[164C┃\r\u001b[21;165H\u001b[38;2;240;246;252m┃\r\r\n\u001b[164C┃\r\r\n\u001b[164C┃\r\u001b[33;2H\u001b[38;2;61;68;77m│\u001b[m ── high-maintainability (4 issue(s)) ──\u001b[122C\u001b[38;2;145;152;161m┃\r\r\n\u001b[C\u001b[38;2;61;68;77m│\u001b[162C\u001b[38;2;145;152;161m┃\r\r\n\u001b[C\u001b[38;2;61;68;77m│\u001b[m A low maintainability index means too much code, decision-making, or detail is concentrated in one place. The number is a signal to investigate, not a\u001b[11C\u001b[38;2;145;152;161m┃\u001b[m\u001b[?2026l\r\u001b[38;3H\u001b[?25h"]
[0.047, "o", "\u001b[?2026h\u001b[?25l\r\n\r\n \u001b[38;2;68;147;248m◎\u001b[m \u001b[?2026l\u001b[2A\b\u001b[?25h"]
[0.034, "o", "\u001b[?2026h\u001b[?25l\u001b[3;35r\u001b[35;1H\r\n\r\n\r\n\u001b[r\u001b[14;165H\u001b[38;2;145;152;161m┃\r\r\n\u001b[164C┃\r\r\n\u001b[164C┃\r\r\n\u001b[164C┃\r\u001b[21;165H\u001b[38;2;240;246;252m┃\r\r\n\u001b[164C┃\r\r\n\u001b[164C┃\r\r\n\u001b[164C┃\r\u001b[33;2H\u001b[38;2;61;68;77m│\u001b[m diagnosis. Look for responsibilities mixed together and details that obscure what the code is trying to do.\u001b[54C\u001b[38;2;145;152;161m┃\r\r\n\u001b[C\u001b[38;2;61;68;77m│\u001b[162C\u001b[38;2;145;152;161m┃\r\r\n\u001b[C\u001b[38;2;61;68;77m│\u001b[m Work through it in order:\u001b[136C\u001b[38;2;145;152;161m┃\u001b[m\u001b[?2026l\r\u001b[38;3H\u001b[?25h"]
[0.058, "o", "\u001b[?2026h\u001b[?25l\r\n\r\n \u001b[38;2;68;147;248m◉\u001b[m \u001b[?2026l\u001b[2A\b\u001b[?25h"]
[0.053, "o", "\u001b[?2026h\u001b[?25l\u001b[3;35r\u001b[35;1H\r\n\r\n\r\n\u001b[r\u001b[15;165H\u001b[38;2;145;152;161m┃\r\r\n\u001b[164C┃\r\r\n\u001b[164C┃\r\r\n\u001b[164C┃\r\u001b[22;165H\u001b[38;2;240;246;252m┃\r\r\n\u001b[164C┃\r\r\n\u001b[164C┃\r\r\n\u001b[164C┃\r\u001b[33;2H\u001b[38;2;61;68;77m│\u001b[162C\u001b[38;2;145;152;161m┃\r\r\n\u001b[C\u001b[38;2;61;68;77m│\u001b[m 1. Name the responsibilities. Describe the jobs performed by the reported method or type. Look for boundaries between validation, calculation, state\u001b[13C\u001b[38;2;145;152;161m┃\r\r\n\u001b[C\u001b[38;2;61;68;77m│\u001b[m changes, and interaction with external systems. If the description needs several unrelated clauses, the code probably has more than one responsibility.\u001b[10C\u001b[38;2;145;152;161m┃\u001b[m\u001b[?2026l\r\u001b[38;3H\u001b[?25h"]
[0.037, "o", "\u001b[?2026h\u001b[?25l\r\n\r\n \u001b[38;2;68;147;248m●\u001b[m \u001b[?2026l\u001b[2A\b\u001b[?25h"]
[0.091, "o", "\u001b[?2026h\u001b[?25l\r\n\r\n \u001b[38;2;68;147;248m◉\u001b[m \u001b[?2026l\u001b[2A\b\u001b[?25h"]
[0.072, "o", "\u001b[?2026h\u001b[?25l\u001b[3;35r\u001b[35;1H\r\n\r\n\r\n\u001b[r\u001b[16;165H\u001b[38;2;145;152;161m┃\r\r\n\u001b[164C┃\r\r\n\u001b[164C┃\r\u001b[23;165H\u001b[38;2;240;246;252m┃\r\r\n\u001b[164C┃\r\r\n\u001b[164C┃\r\u001b[33;2H\u001b[38;2;61;68;77m│\u001b[m 2. Separate intent from detail. Extract cohesive steps into methods named for what they accomplish. Keep the calling method readable as a description of the\u001b[5C\u001b[38;2;145;152;161m┃\r\r\n\u001b[C\u001b[38;2;61;68;77m│\u001b[m  operation. Prefer explicit inputs and results over helpers that depend on hidden mutable state or require many flags.\u001b[43C\u001b[38;2;145;152;161m┃\r\r\n\u001b[C\u001b[38;2;61;68;77m│\u001b[m 3. Simplify what remains. Remove duplicated work, unnecessary intermediate state, and repeated calculations where doing so preserves behavior. Give\u001b[14C\u001b[38;2;145;152;161m┃\u001b[m\u001b[?2026l\r\u001b[38;3H\u001b[?25h"]
[0.034, "o", "\u001b[?2026h\u001b[?25l\r\n\r\n \u001b[38;2;68;147;248m◎\u001b[m \u001b[?2026l\u001b[2A\b\u001b[?25h"]

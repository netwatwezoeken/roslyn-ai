[0.084, "o", "\u001b[?2026h\u001b[?25l\r\n\r\n \u001b[38;2;68;147;248m◎\u001b[m \u001b[?2026l\u001b[2A\b\u001b[?25h"]
[0.093, "o", "\u001b[?2026h\u001b[?25l\r\n\r\n \u001b[38;2;68;147;248m○\u001b[m \u001b[?2026l\u001b[2A\b\u001b[?25h"]
[0.034, "o", "\u001b[?2026h\u001b[?25l\u001b[3;35r\u001b[35;1H\r\n\r\n\r\n\u001b[r\u001b[10;165H\u001b[38;2;145;152;161m┃\r\r\n\u001b[164C┃\r\r\n\u001b[164C┃\r\r\n\u001b[164C┃\r\u001b[17;165H\u001b[38;2;240;246;252m┃\r\r\n\u001b[164C┃\r\r\n\u001b[164C┃\r\r\n\u001b[164C┃\r\u001b[33;2H\u001b[38;2;61;68;77m│\u001b[162C\u001b[38;2;145;152;161m┃\r\r\n\u001b[C\u001b[38;2;61;68;77m│\u001b[m Work through it in order:\u001b[136C\u001b[38;2;145;152;161m┃\r\r\n\u001b[C\u001b[38;2;61;68;77m│\u001b[162C\u001b[38;2;145;152;161m┃\u001b[m\u001b[?2026l\r\u001b[38;3H\u001b[?25h"]
[0.058, "o", "\u001b[?2026h\u001b[?25l\r\n\r\n \u001b[38;2;68;147;248m◎\u001b[m \u001b[?2026l\u001b[2A\b\u001b[?25h"]
[0.034, "o", "\u001b[?2026h\u001b[?25l\u001b[3;35r\u001b[35;1H\r\n\r\n\r\n\u001b[r\u001b[11;165H\u001b[38;2;145;152;161m┃\r\r\n\u001b[164C┃\r\r\n\u001b[164C┃\r\u001b[18;165H\u001b[38;2;240;246;252m┃\r\r\n\u001b[164C┃\r\r\n\u001b[164C┃\r\u001b[33;2H\u001b[38;2;61;68;77m│\u001b[m 1. **Name what each branch is for.** Give every branch a one-sentence description of the responsibility it handles. If two branches describe the same thing,\u001b[5C\u001b[38;2;145;152;161m┃\r\r\n\u001b[C\u001b[38;2;61;68;77m│\u001b[m  they belong together. If a branch has no clean name, that path probably wants its own function.\u001b[65C\u001b[38;2;145;152;161m┃\r\r\n\u001b[C\u001b[38;2;61;68;77m│\u001b[m 2. **Lift the guards out first.** Turn early-exit conditions into guard clauses (`if not user: return None`) so the happy path stays flat and left-aligned.\u001b[6C\u001b[38;2;145;152;161m┃\u001b[m\u001b[?2026l\r\u001b[38;3H\u001b[?25h"]
[0.056, "o", "\u001b[?2026h\u001b[?25l\r\n\r\n \u001b[38;2;68;147;248m◉\u001b[m \u001b[?2026l\u001b[2A\b\u001b[?25h"]
[0.034, "o", "\u001b[?2026h\u001b[?25l\u001b[3;35r\u001b[35;1H\r\n\r\n\r\n\u001b[r\u001b[11;165H\u001b[38;2;145;152;161m┃\r\r\n\u001b[164C┃\r\r\n\u001b[164C┃\r\r\n\u001b[164C┃\r\u001b[18;165H\u001b[38;2;240;246;252m┃\r\r\n\u001b[164C┃\r\r\n\u001b[164C┃\r\r\n\u001b[164C┃\r\u001b[33;2H\u001b[38;2;61;68;77m│\u001b[m Most of the count is preconditions wrapped around the real work.\u001b[97C\u001b[38;2;145;152;161m┃\r\r\n\u001b[C\u001b[38;2;61;68;77m│\u001b[m 3. **Change the shape, do not just move it.** When every branch is the same kind of decision, reshape it: a long `if/elif` on a value is often a dict\u001b[12C\u001b[38;2;145;152;161m┃\r\r\n\u001b[C\u001b[38;2;61;68;77m│\u001b[m dispatch or polymorphism, a nested loop often a comprehension or a generator. When polymorphism is not the right fit and the branches are genuinely separate\u001b[5C\u001b[38;2;145;152;161m┃\u001b[m\u001b[?2026l\r\u001b[38;3H\u001b[?25h"]
[0.056, "o", "\u001b[?2026h\u001b[?25l\r\n\r\n \u001b[38;2;68;147;248m●\u001b[m \u001b[?2026l\u001b[2A\b\u001b[?25h"]
[0.034, "o", "\u001b[?2026h\u001b[?25l\u001b[3;35r\u001b[35;1H\r\n\r\n\r\n\u001b[r\u001b[12;165H\u001b[38;2;145;152;161m┃\r\r\n\u001b[164C┃\r\r\n\u001b[164C┃\r\r\n\u001b[164C┃\r\u001b[19;165H\u001b[38;2;240;246;252m┃\r\r\n\u001b[164C┃\r\r\n\u001b[164C┃\r\r\n\u001b[164C┃\r\u001b[33;2H\u001b[38;2;61;68;77m│\u001b[m  jobs, extract one named method per branch, each named for the responsibility it handles. The goal is fewer decisions in one place, not the same tangle\u001b[10C\u001b[38;2;145;152;161m┃\r\r\n\u001b[C\u001b[38;2;61;68;77m│\u001b[m split into `_part1` / `_part2` behind worse names.\u001b[111C\u001b[38;2;145;152;161m┃\r\r\n\u001b[C\u001b[38;2;61;68;77m│\u001b[162C\u001b[38;2;145;152;161m┃\u001b[m\u001b[?2026l\r\u001b[38;3H\u001b[?25h"]
[0.057, "o", "\u001b[?2026h\u001b[?25l\r\n\r\n \u001b[38;2;68;147;248m◉\u001b[m \u001b[?2026l\u001b[2A\b\u001b[?25h"]
[0.091, "o", "\u001b[?2026h\u001b[?25l\r\n\r\n \u001b[38;2;68;147;248m◎\u001b[m \u001b[?2026l\u001b[2A\b\u001b[?25h"]
[0.091, "o", "\u001b[?2026h\u001b[?25l\r\n\r\n \u001b[38;2;68;147;248m○\u001b[m \u001b[?2026l\u001b[2A\b\u001b[?25h"]
[0.090, "o", "\u001b[?2026h\u001b[?25l\r\n\r\n \u001b[38;2;68;147;248m◎\u001b[m \u001b[?2026l\u001b[2A\b\u001b[?25h"]
[0.093, "o", "\u001b[?2026h\u001b[?25l\r\n\r\n \u001b[38;2;68;147;248m◉\u001b[m \u001b[?2026l\u001b[2A\b\u001b[?25h"]
[0.071, "o", "\u001b[?2026h\u001b[?25l\r\u001b[12A\u001b[48;2;20;27;34m \u001b[38;2;61;68;77m│\u001b[39m                                                                                                                                                                 \u001b[40;37H\u001b[0;38;2;145;152;161m2.5 \u001b[m\u001b[?2026l\u001b[38;3H\u001b[?25h"]
[0.032, "o", "\u001b[?2026h\u001b[?25l\r\u001b[13A\u001b[48;2;20;27;34m \u001b[38;2;61;68;77m│\u001b[39m Work through it in order:                                                                                                                                       \r\n\u001b[m \u001b[38;2;61;68;77m│\u001b[m                                                                                                                                                                 \u001b[40;2H\u001b[38;2;68;147;248m●\u001b[m \u001b[?2026l\u001b[2A\b\u001b[?25h"]
[0.037, "o", "\u001b[?2026h\u001b[?25l\u001b[15;165H\u001b[38;2;240;246;252m┃\r\u001b[22;165H\u001b[38;2;145;152;161m┃\r\r\n\r\n\u001b[0;48;2;20;27;34m \u001b[38;2;61;68;77m│\u001b[39m                                                                                                                                                                 \r\n\u001b[m \u001b[38;2;61;68;77m│\u001b[m Work through it in order:                                                                                                                                       \u001b[?2026l\u001b[38;3H\u001b[?25h"]
[0.034, "o", "\u001b[?2026h\u001b[?25l\r\u001b[15A\u001b[48;2;20;27;34m \u001b[38;2;61;68;77m│\u001b[39m  one job. The count is the symptom, tangled responsibilities are the cause.                                                                                     \r\n\u001b[m \u001b[38;2;61;68;77m│\u001b[m                                                                                                                                                                 \u001b[?2026l\u001b[38;3H\u001b[?25h"]
[0.033, "o", "\u001b[?2026h\u001b[?25l\r\n\r\n \u001b[38;2;68;147;248m◉\u001b[m \u001b[?2026l\u001b[2A\b\u001b[?25h"]
[0.039, "o", "\u001b]9;4;3;0\u0007"]
[0.020, "o", "\u001b[?2026h\u001b[?25l\r\n\r\n \u001b[38;2;68;147;248m◎\u001b[m \u001b[?2026l\u001b[2A\b\u001b[?25h"]
[0.034, "o", "\u001b[?2026h\u001b[?25l\r\u001b[16A\u001b[48;2;20;27;34m \u001b[38;2;61;68;77m│\u001b[39m High complexity means one function is making too many decisions at once. The smell is not the number, it is that the function has quietly taken on more than    \r\n\u001b[m \u001b[38;2;61;68;77m│\u001b[m  one job. The count is the symptom, tangled responsibilities are the cause.                                                                                     \u001b[?2026l\u001b[38;3H\u001b[?25h"]
[0.060, "o", "\u001b[?2026h\u001b[?25l\r\n\r\n \u001b[38;2;68;147;248m○\u001b[m \u001b[?2026l\u001b[2A\b\u001b[?25h"]
